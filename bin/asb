#!/bin/sh
# Agent Sync Bridge CLI. Stdlib-only Python; system python3 is enough.
# Also runs under Git Bash on Windows, where Python is started through `py`.
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
ENTRY="$(cd "$(dirname "$SELF")" && pwd)/asb.py"
if [ -n "$ASB_PYTHON" ]; then exec "$ASB_PYTHON" -X utf8 -I "$ENTRY" "$@"; fi
if [ -x /usr/bin/python3 ]; then exec /usr/bin/python3 -X utf8 -I "$ENTRY" "$@"; fi
if command -v py >/dev/null 2>&1; then exec py -3 -X utf8 -I "$ENTRY" "$@"; fi
exec python3 -X utf8 -I "$ENTRY" "$@"
